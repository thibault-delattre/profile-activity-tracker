{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Activity Tracker configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "introduction",
    "about",
    "additionalUsernames",
    "excludedRepositories",
    "brand"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "introduction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "about": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "additionalUsernames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
      }
    },
    "excludedRepositories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent"
      ],
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}
